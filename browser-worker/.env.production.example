# Copy to .env on the Linux worker host. Never commit the populated .env.
ALLOWED_ORIGINS=https://infobridgeindia.online
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR-EXISTING-PUBLISHABLE-KEY
# Required: existing authorized Supabase Auth user UUID(s), comma-separated.
SCREEN_VIEW_ADMIN_IDS=
BROWSER_DOMAIN=browser.infobridgeindia.online
MAX_SESSIONS=4
# Compose supplies NODE_ENV, EGRESS_ISOLATED and EGRESS_PROXY.
# Worker port stays 8090; do not publish worker or egress ports.
